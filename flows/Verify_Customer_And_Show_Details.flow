<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>63.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <assignments>
        <name>Copy_1_of_OutputDetails</name>
        <label>Copy 1 of OutputDetails</label>
        <locationX>1634</locationX>
        <locationY>350</locationY>
        <assignmentItems>
            <assignToReference>OutputVar</assignToReference>
            <operator>Assign</operator>
            <value>
                <stringValue>It seems we couldn&apos;t find your details. Are you a new customer? Would you like me to register you, or could you please re-check your email address?</stringValue>
            </value>
        </assignmentItems>
    </assignments>
    <assignments>
        <name>Copy_2_of_OutputDetails</name>
        <label>Copy 2 of OutputDetails</label>
        <locationX>1106</locationX>
        <locationY>782</locationY>
        <assignmentItems>
            <assignToReference>OutputVar</assignToReference>
            <operator>Assign</operator>
            <value>
                <stringValue>Hi {!Get_Customer_Details.Name}! We found your vehicle {!Get_Vehicle_Details.Name} (Brand: {!Get_Vehicle_Details.Brand__c}, Model: {!Get_Vehicle_Details.Model__c}), but no active service booking is associated with it. Would you like to book a service?</stringValue>
            </value>
        </assignmentItems>
    </assignments>
    <assignments>
        <name>Copy_3_of_OutputDetails</name>
        <label>Copy 3 of OutputDetails</label>
        <locationX>1370</locationX>
        <locationY>566</locationY>
        <assignmentItems>
            <assignToReference>OutputVar</assignToReference>
            <operator>Assign</operator>
            <value>
                <stringValue>Hi {!Get_Customer_Details.Name}! We couldn&apos;t find any vehicle associated with your profile. Would you like to register your vehicle with us?</stringValue>
            </value>
        </assignmentItems>
    </assignments>
    <assignments>
        <name>Copy_4_of_OutputDetails</name>
        <label>Copy 4 of OutputDetails</label>
        <locationX>314</locationX>
        <locationY>890</locationY>
        <assignmentItems>
            <assignToReference>OutputVar</assignToReference>
            <operator>Assign</operator>
            <value>
                <stringValue>Hi {!Get_Customer_Details.Name}, Good news! Your vehicle {!Get_Vehicle_Details.Name} (Brand: {!Get_Vehicle_Details.Brand__c}, Model: {!Get_Vehicle_Details.Model__c}) is ready for pickup. Please visit us during your scheduled slot or let us know if you need assistance.</stringValue>
            </value>
        </assignmentItems>
    </assignments>
    <assignments>
        <name>Copy_5_of_OutputDetails</name>
        <label>Copy 5 of OutputDetails</label>
        <locationX>578</locationX>
        <locationY>890</locationY>
        <assignmentItems>
            <assignToReference>OutputVar</assignToReference>
            <operator>Assign</operator>
            <value>
                <stringValue>Hi {!Get_Customer_Details.Name}, Your vehicle {!Get_Vehicle_Details.Name} (Brand: {!Get_Vehicle_Details.Brand__c}, Model: {!Get_Vehicle_Details.Model__c}) is currently under servicing. Our team is taking care of it!</stringValue>
            </value>
        </assignmentItems>
    </assignments>
    <assignments>
        <name>Copy_6_of_OutputDetails</name>
        <label>Copy 6 of OutputDetails</label>
        <locationX>842</locationX>
        <locationY>890</locationY>
        <assignmentItems>
            <assignToReference>OutputVar</assignToReference>
            <operator>Assign</operator>
            <value>
                <stringValue>Hi {!Get_Customer_Details.Name}, We’re happy to inform you that your vehicle {!Get_Vehicle_Details.Name} (Brand: {!Get_Vehicle_Details.Brand__c}, Model: {!Get_Vehicle_Details.Model__c}) has been delivered. Thank you for choosing our service!</stringValue>
            </value>
        </assignmentItems>
    </assignments>
    <assignments>
        <name>OutputDetails</name>
        <label>OutputDetails</label>
        <locationX>50</locationX>
        <locationY>890</locationY>
        <assignmentItems>
            <assignToReference>OutputVar</assignToReference>
            <operator>Assign</operator>
            <value>
                <stringValue>Hi {!Get_Customer_Details.Name}, Your service for {!Get_Vehicle_Details.Name} (Brand: {!Get_Vehicle_Details.Brand__c}, Model: {!Get_Vehicle_Details.Model__c}) is scheduled on {!Get_Service_Details.Service_Date__c} at {!Get_Service_Details.Booking_Slot__c}. We look forward to serving you!</stringValue>
            </value>
        </assignmentItems>
    </assignments>
    <decisions>
        <name>Based_on_Status</name>
        <label>Based on Status</label>
        <locationX>446</locationX>
        <locationY>782</locationY>
        <defaultConnector>
            <targetReference>Copy_6_of_OutputDetails</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Delivered</defaultConnectorLabel>
        <rules>
            <name>Scheduled</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Get_Service_Details.Status__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Scheduled</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>OutputDetails</targetReference>
            </connector>
            <label>Scheduled</label>
        </rules>
        <rules>
            <name>Ready</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Get_Service_Details.Status__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Ready</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Copy_4_of_OutputDetails</targetReference>
            </connector>
            <label>Ready</label>
        </rules>
        <rules>
            <name>Servicing</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Get_Service_Details.Status__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Servicing</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Copy_5_of_OutputDetails</targetReference>
            </connector>
            <label>Servicing</label>
        </rules>
    </decisions>
    <decisions>
        <name>Customer_Exists</name>
        <label>Customer Exists?</label>
        <locationX>1353</locationX>
        <locationY>242</locationY>
        <defaultConnector>
            <targetReference>Copy_1_of_OutputDetails</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Yes</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Get_Customer_Details</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Get_Vehicle_Details</targetReference>
            </connector>
            <label>Yes</label>
        </rules>
    </decisions>
    <decisions>
        <name>Services_done_or_not</name>
        <label>Services done or not?</label>
        <locationX>776</locationX>
        <locationY>674</locationY>
        <defaultConnector>
            <targetReference>Copy_2_of_OutputDetails</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>YesService</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Get_Service_Details</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Based_on_Status</targetReference>
            </connector>
            <label>YesService</label>
        </rules>
    </decisions>
    <decisions>
        <name>Vehicle_Found_or_Not</name>
        <label>Vehicle Found or Not?</label>
        <locationX>1073</locationX>
        <locationY>458</locationY>
        <defaultConnector>
            <targetReference>Copy_3_of_OutputDetails</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>YesVehicle</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Get_Vehicle_Details</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Get_Service_Details</targetReference>
            </connector>
            <label>Yes</label>
        </rules>
    </decisions>
    <description>Flow to verify the customer and show its vehicles details.</description>
    <environments>Default</environments>
    <interviewLabel>Verify Customer And Show Details {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Verify Customer And Show Details</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <recordLookups>
        <name>Get_Customer_Details</name>
        <label>Get Customer Details</label>
        <locationX>1353</locationX>
        <locationY>134</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Customer_Exists</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Email</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>emailId</elementReference>
            </value>
        </filters>
        <getFirstRecordOnly>true</getFirstRecordOnly>
        <object>Contact</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <recordLookups>
        <name>Get_Service_Details</name>
        <label>Get Service Details</label>
        <locationX>776</locationX>
        <locationY>566</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Services_done_or_not</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Vehicle__c</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>Get_Vehicle_Details.Id</elementReference>
            </value>
        </filters>
        <getFirstRecordOnly>true</getFirstRecordOnly>
        <object>Service__c</object>
        <sortField>CreatedDate</sortField>
        <sortOrder>Desc</sortOrder>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <recordLookups>
        <name>Get_Vehicle_Details</name>
        <label>Get Vehicle Details</label>
        <locationX>1073</locationX>
        <locationY>350</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Vehicle_Found_or_Not</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Vehicle_Owner__c</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>Get_Customer_Details.Id</elementReference>
            </value>
        </filters>
        <getFirstRecordOnly>true</getFirstRecordOnly>
        <object>Vehicle__c</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <runInMode>SystemModeWithoutSharing</runInMode>
    <start>
        <locationX>1227</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Get_Customer_Details</targetReference>
        </connector>
    </start>
    <status>Active</status>
    <variables>
        <description>Store the email address of the customer to verify its details.</description>
        <name>emailId</name>
        <dataType>String</dataType>
        <isCollection>false</isCollection>
        <isInput>true</isInput>
        <isOutput>false</isOutput>
    </variables>
    <variables>
        <description>Variable to show details as found from the flow</description>
        <name>OutputVar</name>
        <dataType>String</dataType>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>true</isOutput>
    </variables>
</Flow>
